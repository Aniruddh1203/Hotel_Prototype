{
  "name": "the-moments-hotel-backend",
  "version": "1.0.0",
  "description": "Automated Transactional Email Service for The Moments Hotel System",
  "main": "server.js",
  "scripts": {
    "prestart": "node -e \"if (!require('fs').existsSync('./node_modules')) require('child_process').execSync('npm install', {stdio: 'inherit'})\"",
    "predev": "node -e \"if (!require('fs').existsSync('./node_modules')) require('child_process').execSync('npm install', {stdio: 'inherit'})\"",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "keywords": [
    "nodemailer",
    "transactional-email",
    "express",
    "hotel-booking"
  ],
  "author": "",
  "license": "ISC"
}
